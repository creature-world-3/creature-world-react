rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users 컬렉션 ──
    // 읽기: 로그인한 유저라면 누구의 문서든 읽기 가능 (랭킹 기능)
    // 쓰기: 본인 문서만 가능
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── mailbox 컬렉션 ──
    // 읽기: 로그인한 유저 누구나
    // 생성: 로그인한 유저 (레이드 보상, 친구 초대 보상)
    // 수정/삭제: 불가
    match /mailbox/{mailId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── posts 컬렉션 ──
    // 읽기: 로그인한 유저 누구나 (게시판 목록)
    // 생성: 로그인한 유저, 본인 uid로만
    // 삭제: 본인 글만
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── trades 컬렉션 ──
    // 읽기: 로그인한 유저 누구나 (거래소 목록)
    // 생성: 로그인한 유저, 본인 uid로만
    // 수정: 본인 등록 카드 취소 or 트랜잭션(구매)으로 status 변경
    // 삭제: 본인 등록 카드만 (취소 / 보상 수령 후 정리)
    match /trades/{tradeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── raids 컬렉션 ──
    // 읽기/쓰기: 로그인한 유저 (레이드 참여·데미지 업데이트)
    match /raids/{raidId}/channels/{channelId} {
      allow read, write: if request.auth != null;
    }
  }
}
